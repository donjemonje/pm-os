generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// Per-organization feature overrides, e.g. {"ideas": true}. A key that is
  /// present wins; a missing key falls back to the env default (IDEAS_ENABLED
  /// etc.). Managed in PM-OS Admin → Configurations.
  features  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  workspace Workspace?
}

/// Minimized IAM. PMOS_ADMIN grants access to PM-OS Admin. CUSTOMER_ADMIN is a
/// plain user who may also change their own organization's settings (product
/// lines) — never /admin. Default USER = deny-by-default.
enum UserRole {
  USER
  CUSTOMER_ADMIN
  PMOS_ADMIN
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String?
  name                String
  role                UserRole      @default(USER)
  /// Soft-deactivation: set = user cannot log in and active sessions are
  /// rejected. Cleared to reactivate. No hard delete from Admin.
  deactivatedAt       DateTime?
  /// AES-256-GCM encrypted TOTP secret; null until 2FA enrollment starts.
  totpSecretEnc       String?
  /// Set when the user confirms their first TOTP code; null = 2FA off.
  totpEnabledAt       DateTime?
  /// Highest TOTP time-step already consumed — codes are strictly single-use.
  /// Recovery is admin-side (clear the totp fields), not backup codes.
  totpLastUsedStep    Int?
  /// Optional per-user default Product Line filter for the Ideas screen —
  /// names from the workspace catalog. Empty = no default filter.
  defaultProductLines Json          @default("[]")
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions            Session[]
  accounts            OAuthAccount[]
  chatSessions        ChatSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String   @unique
  expiresAt         DateTime
  /// False until the TOTP challenge passes; only checked when the user has
  /// 2FA enabled, so pre-2FA sessions stay valid.
  twoFactorVerified Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @default("My Workspace")
  /// Ideas → Jira output mapping (field names, write policies, description
  /// format, ticket-link template). Customer-facing output rules change
  /// often, so they live in Admin → Ideas, not in code. Shape:
  /// lib/ideas/jira-mapping.ts.
  ideasConfig    Json         @default("{}")
  /// Jira is enabled for the organization, so it must work: when PM-OS
  /// support was last emailed that it is not working (first failure, then
  /// one reminder a day — src/lib/jira-alerts.ts) and when the current
  /// incident started. Both null = healthy; cleared when a check passes.
  jiraAlertedAt    DateTime?
  jiraAlertedSince DateTime?
  /// Competitors settings: { scanFrequency: "daily"|"weekly"|"monthly",
  /// maxPagesPerScan: number, manualRescansPerDay: number }. Shape + defaults:
  /// lib/competitors/config.ts.
  competitorsConfig Json       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jiraConnection        JiraConnection?
  googleDriveConnection GoogleDriveConnection?
  releases              Release[]
  documents             Document[]
  chatSessions          ChatSession[]
  qaLogs                QALog[]
  zendeskTickets        ZendeskTicketRaw[]
  ledgerEntries         LedgerEntry[]
  ideaBatches           IdeaBatch[]
  ideas                 Idea[]
  jiraIdeaSnapshots     JiraIdeaSnapshot[]
  reviewEvents          ReviewEvent[]
  productLines          ProductLine[]
  usageEvents           UsageEvent[]
  platforms             Platform[]
  customers             Customer[]
  ideasPushUndos        IdeasPushUndo[]
  competitors           Competitor[]
  competitorDomains     CompetitorDomain[]
  capabilities          Capability[]
}

/// Per-idea undo snapshot for the LAST merge to Jira only — executePush
/// clears the workspace's rows before writing new ones, and a successful
/// undo deletes its row. Payload shape: src/lib/ideas/undo.ts.
model IdeasPushUndo {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideaId      String    @unique
  jiraKey     String
  action      String // "create" | "update"
  payload     Json
  commentId   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

/// Workspace-scoped product-line catalog, managed in Settings → Ideas.
/// Idea.products stays plain strings; this is the reference list.
model ProductLine {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Manual sort order (Settings → Ideas → Product Lines); ties break by name.
  position    Int       @default(0)
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  /// "manual" (Settings → Ideas) or "jira" (auto-created by the Jira pull
  /// from the configured product-line field — see IdeasJiraConfig.pull).
  origin      String    @default("manual")
  /// Other spellings that mean this product line — the customer's Jira option
  /// name ("Platform General" for "Platform"), reporters' variants. Matched by
  /// normalized key on import (Jira pull and Zendesk Module); on push the
  /// alias that is a Jira option is written.
  aliases     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Workspace-scoped customer catalog, managed in Settings → Ideas. The
/// catalog stage tags tickets with affected customers from this list only —
/// a closed vocabulary, so idea views never show invented customer names.
model Customer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  /// Spellings merged into this customer (Settings → Customers → Merge);
  /// imports map them here, and a merge can be split back out.
  aliases     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Workspace-scoped platform catalog (iOS, Web, …), managed in Settings → Ideas.
model Platform {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model JiraConnection {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cloudId         String
  siteUrl         String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  /// "basic" — the only supported style since 2026-10-20: a dedicated PM-OS
  /// user + Atlassian API token per organization, set by the PM-OS admin.
  /// accessToken holds base64(email:token) sealed at rest, refreshToken is
  /// empty, expiresAt is far future, requests go to siteUrl directly.
  /// "oauth" rows are legacy (the customer self-connect path was removed)
  /// and count as unavailable until the PM-OS user is set.
  authType        String    @default("basic")
  /// The Jira account behind the token (GET /myself at save time) — shown
  /// in Settings as "Connected as <name> user".
  connectedByName  String?
  connectedByEmail String?
  /// When the API token expires (admin-set at creation, max 1 year). Null = unknown.
  apiTokenExpiresAt DateTime?
  /// When the "token expires soon" email went out to PM-OS support
  /// (src/lib/jira-alerts.ts); cleared when a new token is saved. The
  /// outage flag lives on Workspace.jiraAlertedAt (a missing row must alert too).
  expiryWarnedAt  DateTime?
  projectKeys     String    @default("[]")
  prdSource       String    @default("epic_description")
  /// Ideas write-back target: new ideas become issues of this type in this
  /// project. Must be one of projectKeys so the next import sees what we
  /// created. Null + a single selected project = that project.
  ideasProjectKey String?
  ideasIssueType  String    @default("Story")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GoogleDriveConnection {
  id           String    @id @default(uuid())
  workspaceId  String    @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String?
  folderIds    String    @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Release {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  jiraProjectKey  String
  jiraVersionId   String?
  jiraVersionName String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  documents Document[]

  @@index([workspaceId])
}

model Document {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  releaseId    String?
  release      Release?  @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  type         String
  title        String
  body         String    @default("")
  audience     String    @default("external")
  status       String    @default("draft")
  jiraKeys     String    @default("[]")
  driveFileIds String    @default("[]")
  version      Int       @default(1)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
  @@index([releaseId])
}

model ChatSession {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String    @default("New chat")
  context     String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages ChatMessage[]

  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  String      @default("{}")
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model QALog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueKey    String?
  question    String
  answer      String
  citations   String    @default("[]")
  confidence  String    @default("medium")
  helpful     Boolean?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// ————— Ideas pipeline (Kela POC) —————

/// Raw Zendesk store — tickets exactly as received (PRD). The scrub gate
/// operates on `raw` before anything leaves this store.
model ZendeskTicketRaw {
  id                  String     @id @default(uuid())
  workspaceId         String
  workspace           Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId          String
  subject             String
  body                String
  requester           String?
  /// Customers the catalog stage matched in the ticket text (from the
  /// Customer catalog). Idea-level lists are derived from sources, so this
  /// per-ticket verdict is the single source of truth. Never edited by
  /// review actions — dismissals live in dismissedCustomers so they are
  /// always reversible.
  affectedCustomers   Json       @default("[]")
  /// Names a PM dismissed from the idea view; subtracted from the derived
  /// idea list at read time and restorable at any time.
  dismissedCustomers  Json       @default("[]")
  tags                Json       @default("[]")
  productLine         String?
  /// Reporter-chosen module/product hint (e.g. Zendesk "Module" field) —
  /// a metadata hint for classification, never an override.
  module              String?
  /// Customer named by the reporter in a dedicated field — treated as truth.
  customerName        String?
  /// The reporter marked the ticket as affecting all customers (parsed from
  /// values like "All customers" in the customer fields).
  affectsAllCustomers Boolean    @default(false)
  /// Reporter's "why should we build this" text — interpretation, same
  /// grain of salt as the rest of the ticket.
  whyBuild            String?
  /// Reporter's "what insights do we have" text — interpretation.
  insights            String?
  /// e.g. Yes / No / Helpful — deal linkage as reported.
  dealRelated         String?
  /// e.g. Customer / POC.
  customerType        String?
  /// Direct link to the source ticket; preferred over the URL template.
  url                 String?
  sourceCreatedAt     String?
  /// What the match stage decided per FR unit of this ticket:
  /// [{ unit, ideaId, merged, reason }] — the PM-facing "why" next to the idea link.
  matchNotes          Json       @default("[]")
  raw                 Json
  batchId             String?
  batch               IdeaBatch? @relation(fields: [batchId], references: [id])
  importedAt          DateTime   @default(now())
  catalogKind         String?
  catalogReason       String?

  sources IdeaSource[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
}

/// Verdict ledger — every LLM judgment ever made, content-keyed. Replay of
/// these rows (not model behavior) is what makes the pipeline deterministic.
model LedgerEntry {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String
  stage         String
  promptVersion String
  model         String
  input         Json
  verdict       Json
  createdAt     DateTime  @default(now())

  // Append-only: the same key may appear once per run — comparing rows that
  // share a key is how determinism gets measured, so no unique constraint.
  @@index([workspaceId, key])
  @@index([workspaceId, stage])
}

/// One import run — audit trail plus the notify step later.
model IdeaBatch {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  stats       Json?
  /**
   * running | completed | failed | aborted (server stopped mid-import).
   */
  status      String    @default("running")
  error       String?
  /**
   * Touched after every model call and stage; a stale beat on a running batch = dead run.
   */
  heartbeatAt DateTime  @default(now())
  /**
   * Per-stage timings, call counts, token usage — see src/lib/ideas/trace.ts.
   */
  trace       Json?

  tickets ZendeskTicketRaw[]

  @@index([workspaceId])
}

model Idea {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  details        String
  products       Json      @default("[]")
  platforms      Json      @default("[]")
  batchStatus    String
  decision       String
  origin         String
  /// Human-readable narration of what this import did to an Updated idea
  /// (votes, enrichment, added product lines/platforms). Cleared on rollover.
  batchChanges   Json      @default("[]")
  /// Customers a PM added by hand (names). Ticket-derived customers are
  /// never stored here; removing one of those is a dismissal on its tickets.
  /// The idea as it was before the current batch / before the first PM
  /// change (lib/ideas/changes.ts IdeaBaseline). Null = nothing to compare
  /// (a New idea, or an Unchanged one nobody touched). Set once, cleared on
  /// rollover and after a successful sync to Jira. The drawer's "what
  /// changed" section is the live diff against it.
  batchBaseline  Json?
  addedCustomers Json      @default("[]")
  /// A PM changed the sources after PMOS AI wrote the text: approval is
  /// blocked until the idea is rewritten from its current sources or the PM
  /// explicitly keeps the text (Daniel, 2026-10-19).
  sourcesChanged Boolean   @default(false)
  pmScore        Int?
  manualScore    Int?
  existingVotes  Int       @default(0)
  newVotes       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sources IdeaSource[]
  events  ReviewEvent[]

  @@index([workspaceId])
}

/// Idea ⇄ source links. Zendesk sources are FKs into the raw store; Jira
/// sources are plain issue keys because Jira is live-state, not ours.
model IdeaSource {
  id       String            @id @default(uuid())
  ideaId   String
  idea     Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind     String
  ticketId String?
  ticket   ZendeskTicketRaw? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  jiraKey  String?

  @@index([ideaId])
  @@index([ticketId])
}

/// Jira live-state snapshot, replaced wholesale on every import — a render
/// cache, not a system of record.
model JiraIdeaSnapshot {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key             String
  title           String
  body            String
  status          String?
  url             String?
  components      Json      @default("[]")
  /// Shown on the raw Jira issue in the drawer, like the Zendesk ticket's fields.
  issueType       String?
  priority        String?
  reporter        String?
  assignee        String?
  sourceCreatedAt DateTime?
  syncedAt        DateTime  @default(now())
  /// Customers read from the issue's summary + description (customer-mentions.ts):
  /// catalog names from the deterministic pass, as-written names from the AI
  /// pass (suggestions until approved). PM-OS data, not Jira's — the sync
  /// upserts rows so these survive every pull.
  affectedCustomers  Json    @default("[]")
  /// Names the PM dismissed on this issue (reversible, like a ticket's).
  dismissedCustomers Json    @default("[]")
  /// Hash of the text the AI pass last read; unchanged text = no new call.
  customersTextHash  String?
  /// The issue's fields as the sync compares them (summary, description
  /// text, labels, components, mapped custom fields), read at import. The
  /// drawer's "Changes to sync" diffs against this — no Jira call per open;
  /// Jira is assumed not to change during a merge (Daniel, 2026-10-20).
  syncState          Json?

  @@unique([workspaceId, key])
}

/// Append-only training signal: every manual decision and edit (PRD, day one).
model ReviewEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideaId      String
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  action      String
  payload     Json?
  /// Who did it (null for events logged before 2026-10-19 or by jobs).
  userId      String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, ideaId])
  @@index([workspaceId, createdAt])
}

/// Product-usage telemetry (Admin → Analytics): one narrow append-only row
/// per client event — page views, drawer opens, filters, searches, imports.
/// Behaviour only; decisions and edits are ReviewEvents. Same Postgres for
/// now (one customer, a few thousand rows a day at most); the client batches
/// writes, rows older than the retention window are purged on admin read.
model UsageEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  /// Client tab id for the browsing session (not the auth session).
  sessionId   String?
  event       String
  path        String?
  props       Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, event, createdAt])
}

/// Single-use password-reset tokens (forgot-password email links). Only the
/// SHA-256 hash of the token is stored; the raw token exists only in the
/// emailed link. 24h expiry; consumed on use; password-type users only.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ————— Competitors (story 2: website data → parity matrix + profile) —————
//
// Every row belongs to a workspace. The org's own column of the matrix is
// Capability.ourStatus — the organization is never scanned (Daniel,
// 2026-10-26): its catalog and statuses are entered by its PMs. Design of
// record: the C2 "full-screen matrix" board; spec: "PM-OS Competitor
// Analysis — Spec", tab "Story 2 — Website data".

/// A tracked competitor. One website source each in story 2; competition
/// level (direct/indirect) arrives with story 7.
model Competitor {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Normalized https origin, e.g. https://www.recordedfuture.com
  websiteUrl  String
  /// Registrable host used to keep the crawl inside the site (recordedfuture.com).
  host        String
  logoUrl     String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statuses CapabilityStatus[]
  facts    ProfileFact[]
  sources  CompetitorSource[]
  media    CompetitorMedia[]

  @@unique([workspaceId, host])
  @@index([workspaceId])
}

/// An industry problem/solution area above product lines (Threat intelligence,
/// Exposure & response). Groups the matrix rows. `description` is the long
/// definition PMOS AI classifies with (definition, what belongs here, what
/// does not, typical site phrases) — like a product line's description.
/// Settings → Competitors.
model CompetitorDomain {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  capabilities Capability[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// A matrix row: one domain, many of the org's product lines (names, matched
/// against ProductLine.name). `ourStatus` is the org's own cell — "has" |
/// "partial" | "missing" — set by PMs (default has; a competitor suggestion
/// accepted into the catalog starts as missing = a gap). origin "ai" = a
/// competitor scan suggested it; state "suggested" rows wait for a PM.
model Capability {
  id             String           @id @default(uuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domainId       String
  domain         CompetitorDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name           String
  description    String           @default("")
  /// Product-line names of the org that serve this capability (story 2 decision:
  /// product lines are the org's only; competitor products live in ProfileFact).
  productLines   Json             @default("[]")
  /// "has" | "partial" | "missing"
  ourStatus      String           @default("has")
  position       Int              @default(0)
  /// "manual" | "ai"
  origin         String           @default("manual")
  /// "active" | "suggested" | "dismissed"
  state          String           @default("active")
  /// Which competitor's scan suggested it (null for manual rows).
  suggestedById  String?
  suggestedQuote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  statuses CapabilityStatus[]

  @@unique([workspaceId, name])
  @@index([workspaceId, domainId])
}

/// One matrix cell. `value` is what the last scan found; the override fields,
/// when set, win over every later scan until a PM resets them.
model CapabilityStatus {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  /// "has" | "partial" | "missing" | "unknown"
  value        String     @default("unknown")
  /// 0–1 from PMOS AI; low confidence is shown as "partial?" to confirm.
  confidence   Float?
  quote        String?
  sourceUrl    String?
  scanId       String?
  /// When `value` last changed (drives "New changes" and "Changed <date>").
  changedAt    DateTime?
  overrideValue  String?
  overrideNote   String?
  overrideUserId String?
  overrideAt     DateTime?
  /// The competitor's product or module that ships this capability, as PMOS AI
  /// read it off the pages (groups the profile's capabilities). Null = not stated.
  product      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  history StatusHistory[]

  @@unique([competitorId, capabilityId])
  @@index([workspaceId])
  @@index([workspaceId, changedAt])
}

/// Append-only previous values of a cell — "New changes" now, the news feed later.
model StatusHistory {
  id        String           @id @default(uuid())
  statusId  String
  status    CapabilityStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  value     String
  quote     String?
  sourceUrl String?
  scanId    String?
  at        DateTime         @default(now())

  @@index([statusId, at])
}

/// A lean-profile fact read off the website. `kind` is a closed list:
/// tagline | product | pricingTier | integration | certification | customer | vertical.
model ProfileFact {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  kind         String
  value        String
  sourceUrl    String?
  /// Where it came from, as shown on the card ("LinkedIn", "Trust page", "2024 · press").
  sourceLabel  String?
  /// "warn" paints the source line amber (a change worth noticing).
  tone         String?
  /// The date the source states for the fact (a funding round, a launch, an
  /// acquisition) — the timeline is built from dated facts. Null = undated.
  factDate     DateTime?
  scanId       String?
  changedAt    DateTime   @default(now())
  /// A PM's correction; wins over later scans until cleared.
  overrideValue  String?
  overrideUserId String?
  overrideAt     DateTime?
  /// A PM removed this fact; scans never re-add the same value.
  dismissedAt  DateTime?
  /// Typed by a PM (no source page); never stale, never unreachable.
  manual       Boolean    @default(false)
  /// The last scan that found this fact on the site; stale when 3 scans passed without it.
  lastSeenScanId String?
  /// The fact's page vanished or was blocked in a later scan (cleared when seen again).
  unreachableAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([competitorId, kind, value])
  @@index([workspaceId, competitorId])
}

/// Where a competitor's data comes from. Story 2 = one "website" source per
/// competitor; later stories add more types. Schedule inherits the org's
/// competitorsConfig.scanFrequency.
model CompetitorSource {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  /// One of SOURCE_TYPES (lib/competitors/config.ts): website | documents |
  /// helpcenter | video | archive | apidocs | changelog | code | social |
  /// reviews | marketplaces | press | jobs | events | other. The website is
  /// crawled by the scanner; every other type receives its pages from a
  /// collector (an upload, an import, a later connector) and runs the same
  /// pipeline from there.
  type         String     @default("website")
  url          String
  lastScanAt   DateTime?
  /// "never" | "ok" | "partial" | "failed" | "running"
  lastStatus   String     @default("never")
  lastError    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  scans CompetitorScan[]

  @@unique([competitorId, type])
  @@index([workspaceId])
}

/// One scan run of a source, with its log. `log` is an append-only JSON array
/// of {at, level, msg, url?} lines; `pages` summarises each page fetched
/// ({url, status, outcome: new|changed|unchanged|failed|skipped, chars}).
model CompetitorScan {
  id            String           @id @default(uuid())
  workspaceId   String
  sourceId      String
  source        CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// "manual" | "scheduled" | "import" (pages handed to the pipeline by a collector)
  trigger       String
  startedById   String?
  /// "queued" | "running" | "ok" | "partial" | "failed"
  status        String           @default("queued")
  /// "plain" | "browser" (browser after a bot wall) | "bundle" (pages were handed in, nothing fetched).
  fetchMode     String?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  heartbeatAt   DateTime         @default(now())
  pagesFetched  Int              @default(0)
  pagesChanged  Int              @default(0)
  statusesChanged Int            @default(0)
  factsChanged  Int              @default(0)
  suggestions   Int              @default(0)
  aiCalls       Int              @default(0)
  /// "none" | "timeout" | "http4xx" | "http5xx" | "botwall" | "ai" | "limit" | "other"
  errorKind     String?
  error         String?
  /// What the user sees: "full" | "incomplete" | "blocked" | "unreachable" (null while running).
  badge         String?
  /// Failed/skipped page counts by category: {robots, denied, login, notfound, timeout, cap, policy}.
  outcomes      Json             @default("{}")
  /// robots.txt paths that kept pages out of this scan (first 50).
  robotsDisallowed Json          @default("[]")
  /// URLs present in the previous scan and gone in this one.
  removedPages  Json             @default("[]")
  /// Snippets or facts dropped by the PII check (expected 0).
  piiHits       Int              @default(0)
  pages         Json             @default("[]")
  log           Json             @default("[]")

  pageTexts ScanPage[]

  @@index([workspaceId, startedAt])
  @@index([sourceId, startedAt])
}

/// Text of a fetched page, kept for the last 2 scans of a source (older rows
/// keep only the hash); the diff compares hashes, PMOS AI reads the text.
model ScanPage {
  id          String         @id @default(uuid())
  scanId      String
  scan        CompetitorScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  sourceId    String
  url         String
  /// What the text is: page | document | article | transcript | capture | quotes
  /// (quotes = the evidence lines a collector kept when it did not keep the page text).
  kind        String         @default("page")
  title       String?
  contentHash String
  text        String?
  chars       Int            @default(0)
  /// When the content was published or captured, when the source says so
  /// (an article's updated_at, a video's publish date, an archive capture's
  /// timestamp). Null = only the fetch time is known.
  observedAt  DateTime?
  /// Validators for the next scan's conditional request (If-None-Match / If-Modified-Since).
  etag        String?
  lastModified String?
  fetchedAt   DateTime       @default(now())

  @@index([sourceId, url])
  @@index([scanId])
}

/// A UI capture, image or clip of the competitor's product, stored in the
/// media store (lib/competitors/media.ts) under `mediaPath`.
model CompetitorMedia {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  label        String
  kind         String?
  mediaPath    String
  sourceLabel  String?
  capturedAt   DateTime?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([competitorId])
}
