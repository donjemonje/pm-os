generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// Per-organization feature overrides, e.g. {"ideas": true}. A key that is
  /// present wins; a missing key falls back to the env default (IDEAS_ENABLED
  /// etc.). Managed in PM-OS Admin → Configurations.
  features  Json     @default("{}")
  /// The setup state of Competitors for this organization (lib/competitors/analysis/setup-rules.ts): "required" →
  /// "in_setup" → "done". Set only by PM-OS — turning Competitors on in Admin → Enablements, the setup run, a PM-OS
  /// admin by hand — never by the customer. Until it is "done" an analysis creates no row and the Competitors pages
  /// say "being set up". Null = it was never set (an organization from before the state existed): the state is then
  /// read from its data — a catalog means "done", a setup run that did not finish "in_setup", else "required".
  competitorsSetup String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  workspace Workspace?
}

/// Minimized IAM. PMOS_ADMIN grants access to PM-OS Admin. CUSTOMER_ADMIN is a
/// plain user who may also change their own organization's settings (product
/// lines) — never /admin. Default USER = deny-by-default.
enum UserRole {
  USER
  CUSTOMER_ADMIN
  PMOS_ADMIN
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String?
  name                String
  role                UserRole      @default(USER)
  /// Soft-deactivation: set = user cannot log in and active sessions are
  /// rejected. Cleared to reactivate. No hard delete from Admin.
  deactivatedAt       DateTime?
  /// AES-256-GCM encrypted TOTP secret; null until 2FA enrollment starts.
  totpSecretEnc       String?
  /// Set when the user confirms their first TOTP code; null = 2FA off.
  totpEnabledAt       DateTime?
  /// Highest TOTP time-step already consumed — codes are strictly single-use.
  /// Recovery is admin-side (clear the totp fields), not backup codes.
  totpLastUsedStep    Int?
  /// Optional per-user default Product Line filter for the Ideas screen —
  /// names from the workspace catalog. Empty = no default filter.
  defaultProductLines Json          @default("[]")
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions            Session[]
  accounts            OAuthAccount[]
  chatSessions        ChatSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String   @unique
  expiresAt         DateTime
  /// False until the TOTP challenge passes; only checked when the user has
  /// 2FA enabled, so pre-2FA sessions stay valid.
  twoFactorVerified Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @default("My Workspace")
  /// Ideas → Jira output mapping (field names, write policies, description
  /// format, ticket-link template). Customer-facing output rules change
  /// often, so they live in Admin → Ideas, not in code. Shape:
  /// lib/ideas/jira-mapping.ts.
  ideasConfig    Json         @default("{}")
  /// Jira is enabled for the organization, so it must work: when PM-OS
  /// support was last emailed that it is not working (first failure, then
  /// one reminder a day — src/lib/jira-alerts.ts) and when the current
  /// incident started. Both null = healthy; cleared when a check passes.
  jiraAlertedAt    DateTime?
  jiraAlertedSince DateTime?
  /// Competitors settings: { scanFrequency: "daily"|"weekly"|"monthly",
  /// maxPagesPerScan: number, manualRescansPerDay: number }. Shape + defaults:
  /// lib/competitors/config.ts.
  competitorsConfig Json       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jiraConnection        JiraConnection?
  googleDriveConnection GoogleDriveConnection?
  releases              Release[]
  documents             Document[]
  chatSessions          ChatSession[]
  qaLogs                QALog[]
  zendeskTickets        ZendeskTicketRaw[]
  ledgerEntries         LedgerEntry[]
  ideaBatches           IdeaBatch[]
  ideas                 Idea[]
  jiraIdeaSnapshots     JiraIdeaSnapshot[]
  reviewEvents          ReviewEvent[]
  productLines          ProductLine[]
  usageEvents           UsageEvent[]
  platforms             Platform[]
  customers             Customer[]
  ideasPushUndos        IdeasPushUndo[]
  competitors           Competitor[]
  competitorDomains     CompetitorDomain[]
  capabilities          Capability[]
}

/// Per-idea undo snapshot for the LAST merge to Jira only — executePush
/// clears the workspace's rows before writing new ones, and a successful
/// undo deletes its row. Payload shape: src/lib/ideas/undo.ts.
model IdeasPushUndo {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideaId      String    @unique
  jiraKey     String
  action      String // "create" | "update"
  payload     Json
  commentId   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

/// Workspace-scoped product-line catalog, managed in Settings → Ideas.
/// Idea.products stays plain strings; this is the reference list.
model ProductLine {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Manual sort order (Settings → Ideas → Product Lines); ties break by name.
  position    Int       @default(0)
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  /// "manual" (Settings → Ideas) or "jira" (auto-created by the Jira pull
  /// from the configured product-line field — see IdeasJiraConfig.pull).
  origin      String    @default("manual")
  /// Other spellings that mean this product line — the customer's Jira option
  /// name ("Platform General" for "Platform"), reporters' variants. Matched by
  /// normalized key on import (Jira pull and Zendesk Module); on push the
  /// alias that is a Jira option is written.
  aliases     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Workspace-scoped customer catalog, managed in Settings → Ideas. The
/// catalog stage tags tickets with affected customers from this list only —
/// a closed vocabulary, so idea views never show invented customer names.
model Customer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  /// Spellings merged into this customer (Settings → Customers → Merge);
  /// imports map them here, and a merge can be split back out.
  aliases     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Workspace-scoped platform catalog (iOS, Web, …), managed in Settings → Ideas.
model Platform {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model JiraConnection {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cloudId         String
  siteUrl         String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  /// "basic" — the only supported style since 2026-10-20: a dedicated PM-OS
  /// user + Atlassian API token per organization, set by the PM-OS admin.
  /// accessToken holds base64(email:token) sealed at rest, refreshToken is
  /// empty, expiresAt is far future, requests go to siteUrl directly.
  /// "oauth" rows are legacy (the customer self-connect path was removed)
  /// and count as unavailable until the PM-OS user is set.
  authType        String    @default("basic")
  /// The Jira account behind the token (GET /myself at save time) — shown
  /// in Settings as "Connected as <name> user".
  connectedByName  String?
  connectedByEmail String?
  /// When the API token expires (admin-set at creation, max 1 year). Null = unknown.
  apiTokenExpiresAt DateTime?
  /// When the "token expires soon" email went out to PM-OS support
  /// (src/lib/jira-alerts.ts); cleared when a new token is saved. The
  /// outage flag lives on Workspace.jiraAlertedAt (a missing row must alert too).
  expiryWarnedAt  DateTime?
  projectKeys     String    @default("[]")
  prdSource       String    @default("epic_description")
  /// Ideas write-back target: new ideas become issues of this type in this
  /// project. Must be one of projectKeys so the next import sees what we
  /// created. Null + a single selected project = that project.
  ideasProjectKey String?
  ideasIssueType  String    @default("Story")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GoogleDriveConnection {
  id           String    @id @default(uuid())
  workspaceId  String    @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String?
  folderIds    String    @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Release {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  jiraProjectKey  String
  jiraVersionId   String?
  jiraVersionName String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  documents Document[]

  @@index([workspaceId])
}

model Document {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  releaseId    String?
  release      Release?  @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  type         String
  title        String
  body         String    @default("")
  audience     String    @default("external")
  status       String    @default("draft")
  jiraKeys     String    @default("[]")
  driveFileIds String    @default("[]")
  version      Int       @default(1)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
  @@index([releaseId])
}

model ChatSession {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String    @default("New chat")
  context     String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages ChatMessage[]

  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  String      @default("{}")
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model QALog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueKey    String?
  question    String
  answer      String
  citations   String    @default("[]")
  confidence  String    @default("medium")
  helpful     Boolean?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// ————— Ideas pipeline (Kela POC) —————

/// Raw Zendesk store — tickets exactly as received (PRD). The scrub gate
/// operates on `raw` before anything leaves this store.
model ZendeskTicketRaw {
  id                  String     @id @default(uuid())
  workspaceId         String
  workspace           Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId          String
  subject             String
  body                String
  requester           String?
  /// Customers the catalog stage matched in the ticket text (from the
  /// Customer catalog). Idea-level lists are derived from sources, so this
  /// per-ticket verdict is the single source of truth. Never edited by
  /// review actions — dismissals live in dismissedCustomers so they are
  /// always reversible.
  affectedCustomers   Json       @default("[]")
  /// Names a PM dismissed from the idea view; subtracted from the derived
  /// idea list at read time and restorable at any time.
  dismissedCustomers  Json       @default("[]")
  tags                Json       @default("[]")
  productLine         String?
  /// Reporter-chosen module/product hint (e.g. Zendesk "Module" field) —
  /// a metadata hint for classification, never an override.
  module              String?
  /// Customer named by the reporter in a dedicated field — treated as truth.
  customerName        String?
  /// The reporter marked the ticket as affecting all customers (parsed from
  /// values like "All customers" in the customer fields).
  affectsAllCustomers Boolean    @default(false)
  /// Reporter's "why should we build this" text — interpretation, same
  /// grain of salt as the rest of the ticket.
  whyBuild            String?
  /// Reporter's "what insights do we have" text — interpretation.
  insights            String?
  /// e.g. Yes / No / Helpful — deal linkage as reported.
  dealRelated         String?
  /// e.g. Customer / POC.
  customerType        String?
  /// Direct link to the source ticket; preferred over the URL template.
  url                 String?
  sourceCreatedAt     String?
  /// What the match stage decided per FR unit of this ticket:
  /// [{ unit, ideaId, merged, reason }] — the PM-facing "why" next to the idea link.
  matchNotes          Json       @default("[]")
  raw                 Json
  batchId             String?
  batch               IdeaBatch? @relation(fields: [batchId], references: [id])
  importedAt          DateTime   @default(now())
  catalogKind         String?
  catalogReason       String?

  sources IdeaSource[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
}

/// Verdict ledger — every LLM judgment ever made, content-keyed. Replay of
/// these rows (not model behavior) is what makes the pipeline deterministic.
model LedgerEntry {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String
  stage         String
  promptVersion String
  model         String
  input         Json
  verdict       Json
  createdAt     DateTime  @default(now())

  // Append-only: the same key may appear once per run — comparing rows that
  // share a key is how determinism gets measured, so no unique constraint.
  @@index([workspaceId, key])
  @@index([workspaceId, stage])
}

/// One import run — audit trail plus the notify step later.
model IdeaBatch {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  stats       Json?
  /**
   * running | completed | failed | aborted (server stopped mid-import).
   */
  status      String    @default("running")
  error       String?
  /**
   * Touched after every model call and stage; a stale beat on a running batch = dead run.
   */
  heartbeatAt DateTime  @default(now())
  /**
   * Per-stage timings, call counts, token usage — see src/lib/ideas/trace.ts.
   */
  trace       Json?

  tickets ZendeskTicketRaw[]

  @@index([workspaceId])
}

model Idea {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  details        String
  products       Json      @default("[]")
  platforms      Json      @default("[]")
  batchStatus    String
  decision       String
  origin         String
  /// Human-readable narration of what this import did to an Updated idea
  /// (votes, enrichment, added product lines/platforms). Cleared on rollover.
  batchChanges   Json      @default("[]")
  /// Customers a PM added by hand (names). Ticket-derived customers are
  /// never stored here; removing one of those is a dismissal on its tickets.
  /// The idea as it was before the current batch / before the first PM
  /// change (lib/ideas/changes.ts IdeaBaseline). Null = nothing to compare
  /// (a New idea, or an Unchanged one nobody touched). Set once, cleared on
  /// rollover and after a successful sync to Jira. The drawer's "what
  /// changed" section is the live diff against it.
  batchBaseline  Json?
  addedCustomers Json      @default("[]")
  /// A PM changed the sources after PMOS AI wrote the text: approval is
  /// blocked until the idea is rewritten from its current sources or the PM
  /// explicitly keeps the text (Daniel, 2026-10-19).
  sourcesChanged Boolean   @default(false)
  pmScore        Int?
  manualScore    Int?
  existingVotes  Int       @default(0)
  newVotes       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sources IdeaSource[]
  events  ReviewEvent[]
  /// Competitor capabilities (roadmap rows) linked to this idea.
  capabilities CapabilityIdea[]

  @@index([workspaceId])
}

/// Idea ⇄ source links. Zendesk sources are FKs into the raw store; Jira
/// sources are plain issue keys because Jira is live-state, not ours.
model IdeaSource {
  id       String            @id @default(uuid())
  ideaId   String
  idea     Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind     String
  ticketId String?
  ticket   ZendeskTicketRaw? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  jiraKey  String?

  @@index([ideaId])
  @@index([ticketId])
}

/// Jira live-state snapshot, replaced wholesale on every import — a render
/// cache, not a system of record.
model JiraIdeaSnapshot {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key             String
  title           String
  body            String
  status          String?
  url             String?
  components      Json      @default("[]")
  /// Shown on the raw Jira issue in the drawer, like the Zendesk ticket's fields.
  issueType       String?
  priority        String?
  reporter        String?
  assignee        String?
  sourceCreatedAt DateTime?
  syncedAt        DateTime  @default(now())
  /// Customers read from the issue's summary + description (customer-mentions.ts):
  /// catalog names from the deterministic pass, as-written names from the AI
  /// pass (suggestions until approved). PM-OS data, not Jira's — the sync
  /// upserts rows so these survive every pull.
  affectedCustomers  Json    @default("[]")
  /// Names the PM dismissed on this issue (reversible, like a ticket's).
  dismissedCustomers Json    @default("[]")
  /// Hash of the text the AI pass last read; unchanged text = no new call.
  customersTextHash  String?
  /// The issue's fields as the sync compares them (summary, description
  /// text, labels, components, mapped custom fields), read at import. The
  /// drawer's "Changes to sync" diffs against this — no Jira call per open;
  /// Jira is assumed not to change during a merge (Daniel, 2026-10-20).
  syncState          Json?

  @@unique([workspaceId, key])
}

/// Append-only training signal: every manual decision and edit (PRD, day one).
model ReviewEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideaId      String
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  action      String
  payload     Json?
  /// Who did it (null for events logged before 2026-10-19 or by jobs).
  userId      String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, ideaId])
  @@index([workspaceId, createdAt])
}

/// Product-usage telemetry (Admin → Analytics): one narrow append-only row
/// per client event — page views, drawer opens, filters, searches, imports.
/// Behaviour only; decisions and edits are ReviewEvents. Same Postgres for
/// now (one customer, a few thousand rows a day at most); the client batches
/// writes, rows older than the retention window are purged on admin read.
model UsageEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  /// Client tab id for the browsing session (not the auth session).
  sessionId   String?
  event       String
  path        String?
  props       Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, event, createdAt])
}

/// Single-use password-reset tokens (forgot-password email links). Only the
/// SHA-256 hash of the token is stored; the raw token exists only in the
/// emailed link. 24h expiry; consumed on use; password-type users only.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ————— Competitors (story 2: website data → parity matrix + profile) —————
//
// Every row belongs to a workspace. The org's own column of the matrix is
// Capability.ourStatus. Until 2026-11-15 the organization was never scanned
// (Daniel, 2026-10-26: its catalog and statuses are entered by its PMs); since
// then an organization may have its OWN website stored as a Competitor row
// flagged isOwn ("the own source"): what it says fills ourStatus where no PM
// set it by hand. Organizations without one are unchanged. Design of
// record: the C2 "full-screen matrix" board; spec: "PM-OS Competitor
// Analysis — Spec", tab "Story 2 — Website data".

/// A tracked competitor. One website source each in story 2; competition
/// level (direct/indirect) arrives with story 7.
model Competitor {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Normalized https origin, e.g. https://www.recordedfuture.com
  websiteUrl  String
  /// Registrable host used to keep the crawl inside the site (recordedfuture.com).
  host        String
  logoUrl     String?
  position    Int       @default(0)
  /// Soft delete (Website Scanning PRD 2026-11-04): pages, hashes and scan history stay for the retention period; re-adding the same host restores the row.
  deletedAt   DateTime?
  /// The organization's OWN website — "the own source" (Capability Analysis, the setup run; lib/competitors/own.ts).
  /// Stored, scanned, mapped and read exactly like a competitor's site, but NEVER shown or counted as a competitor:
  /// every listing of competitors leaves it out. At most one per workspace (enforced where it is created). What its
  /// pages say is OURS: it fills Capability.ourStatus / Feature.ourStatus, never a CapabilityStatus cell.
  isOwn       Boolean   @default(false)
  /// The search for the company's other addresses — help center, developer docs, release notes (lib/competitors/discovery.ts).
  /// Set while a search is working (one at a time per company; a search that stopped reporting is taken over after 10 minutes).
  addressSearchStartedAt DateTime?
  /// What the last search that finished says: { status: "done" | "undecided", at, trigger, candidates, added, note }.
  addressSearch          Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statuses CapabilityStatus[]
  facts    ProfileFact[]
  sources  CompetitorSource[]
  media    CompetitorMedia[]
  analyses        CompetitorAnalysis[]
  items           CompetitorItem[]
  findings        PageFinding[]
  featureStatuses FeatureStatus[]
  sections        CompetitorSection[]

  @@unique([workspaceId, host])
  @@index([workspaceId])
}

/// An industry problem/solution area above product lines (Threat intelligence,
/// Exposure & response). Groups the matrix rows. `description` is the long
/// definition PMOS AI classifies with (definition, what belongs here, what
/// does not, typical site phrases) — like a product line's description.
/// Settings → Competitors.
model CompetitorDomain {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// The PMOS AI definition (definition, belongs here, not here, typical phrases); feeds the scan prompt.
  description String    @default("")
  /// Two or three plain sentences for people: the matrix tooltip and the profile deep dive.
  summary     String    @default("")
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  position    Int       @default(0)
  /// "manual" | "ai" (a competitor scan proposed it when no catalog domain fit)
  origin      String    @default("manual")
  /// "active" | "suggested" (dashed group in the matrix, waits for a PM) | "dismissed" (never suggested again)
  /// | "removed" (a PM removed it: kept as a record so scans never bring it back; restorable from Settings)
  state       String    @default("active")
  /// Which competitor's scan suggested it (null for manual domains).
  suggestedById String?
  /// Names a PM replaced by renaming — a scan that meets one of them recognises this domain instead of proposing a new one.
  aliases     Json      @default("[]")
  removedAt   DateTime?
  /// The PM who removed it (plain id, no relation: the record outlives the user).
  removedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  capabilities Capability[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// A matrix row: one domain, many of the org's product lines (names, matched
/// against ProductLine.name). `ourStatus` is the org's own cell — "found" |
/// "not_found" — set by PMs (default found; a capability an analysis found only
/// at a competitor starts as not_found = a gap). origin "ai" = an analysis added it.
model Capability {
  id             String           @id @default(uuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domainId       String
  domain         CompetitorDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name           String
  /// Plain text for people: the pain and what the capability does (row tooltip; also in the scan prompt).
  description    String           @default("")
  /// The org's own product or module that carries this capability — a chip in the org's column.
  ownProduct     String           @default("")
  /// Product-line names of the org that serve this capability (story 2 decision:
  /// product lines are the org's only; competitor products live in ProfileFact).
  productLines   Json             @default("[]")
  /// "found" | "not_found"
  ourStatus      String           @default("found")
  /// Set when a PM set ourStatus by hand (and for every row that existed when the organization's own site was added):
  /// the PM's value is the truth — no run changes ourStatus again. Null = a run may set it from the own source.
  ourStatusSetAt   DateTime?
  /// The PM who set it (plain id, no relation); null when it was frozen by adding the own site.
  ourStatusSetById String?
  /// The top-ranked evidence from the organization's own source behind the own cell, written by the own source's
  /// analysis: { quote, sourceUrl, reasoning, wording, description, count }. Null = no evidence of ours.
  ourEvidence    Json?
  position       Int              @default(0)
  /// "manual" | "ai"
  origin         String           @default("manual")
  /// "active" | "suggested" | "dismissed" | "removed" (a PM removed it: the row, its statuses and idea links are kept
  /// so scans never add it back and a restore brings the evidence with it)
  state          String           @default("active")
  /// Which competitor's scan suggested it (null for manual rows).
  suggestedById  String?
  suggestedQuote String?
  /// Names a PM replaced by renaming — a scan that meets one of them recognises this row instead of proposing a new one.
  aliases        Json             @default("[]")
  removedAt      DateTime?
  /// The PM who removed it (plain id, no relation: the record outlives the user).
  removedById    String?
  /// Set when an analysis created the row inside a suggested domain: the existing domain PMOS AI named as closest
  /// (plain id, no relation). A declined domain moves the row there.
  closestDomainId String?
  /// Ideas this roadmap row is linked to: created from the row, or matched to an existing idea.
  ideas          CapabilityIdea[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  statuses CapabilityStatus[]
  features Feature[]
  items    CompetitorItem[]
  findings PageFinding[]

  @@unique([workspaceId, name])
  @@index([workspaceId, domainId])
}

/// One matrix cell. `value` is what the last scan found; the override fields,
/// when set, win over every later scan until a PM resets them.
/// Roadmap row ⇄ Idea. `origin` = "created" (the row's Create idea button) or
/// "matched" (an existing idea linked to the row by hand or by PMOS AI).
model CapabilityIdea {
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  ideaId       String
  idea         Idea       @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  origin       String     @default("matched")
  createdAt    DateTime   @default(now())

  @@id([capabilityId, ideaId])
  @@index([ideaId])
}

model CapabilityStatus {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  /// "found" | "low" | "not_found" — set by the analysis run's apply step from the evidence, by fixed rules.
  value        String     @default("not_found")
  /// No longer written or read (the confidence is a value now); left in place for a later cleanup push.
  confidence   Float?
  /// The top-ranked evidence behind the cell (the rest is the PageFinding rows): quote, page, why, their name for it.
  quote        String?
  sourceUrl    String?
  reasoning    String?
  wording      String?
  /// One plain sentence of what it does at this competitor: the description of the best-ranked evidence that has one.
  description  String?
  /// Distinct pages that carry evidence for the cell.
  evidenceCount Int       @default(0)
  /// The analysis run that last wrote the cell.
  analysisId   String?
  /// What the last second look that found nothing was asked with (analysis/secondlook.ts lookKey); same key = not asked again.
  lookKey      String?
  scanId       String?
  /// When `value` last changed (drives "New changes" and "Changed <date>").
  changedAt    DateTime?
  overrideValue  String?
  overrideNote   String?
  overrideUserId String?
  overrideAt     DateTime?
  /// The competitor's product or module that ships this capability, as PMOS AI
  /// read it off the pages (groups the profile's capabilities). Null = not stated.
  product      String?
  /// PMOS AI's one-sentence digest of the last change of this cell (what they now offer), and the page's preview image.
  summary      String?
  imageUrl     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  history StatusHistory[]

  @@unique([competitorId, capabilityId])
  @@index([workspaceId])
  @@index([workspaceId, changedAt])
}

/// Append-only previous values of a cell — "New changes" now, the news feed later.
model StatusHistory {
  id        String           @id @default(uuid())
  statusId  String
  status    CapabilityStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)
  value     String
  quote     String?
  sourceUrl String?
  scanId    String?
  at        DateTime         @default(now())

  @@index([statusId, at])
}

/// One analysis of one competitor's stored pages (Capability Analysis, "How the analysis runs").
/// Queued by a finished scan, by a catalog change, or by a PM-OS admin. One run executes at a time, oldest first.
model CompetitorAnalysis {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  /// "analysis" = one competitor's stored pages (the default). "setup" = THE SETUP RUN of a workspace (analysis/setup.ts):
  /// the first run of an organization, attached to its own source (competitorId), working on the own source and every
  /// competitor. It lives in this table so it takes its turn in the same queue: one run at a time in the installation.
  kind         String     @default("analysis")
  /// kind "setup" only — per-company progress and totals, written with every heartbeat:
  /// { companies: [{ competitorId, name, own, stage, pagesTotal, pagesDone, appliedAt, counters, usage }], shared: counters,
  ///   sharedUsage, rows, domains, features }.
  setup        Json?
  /// The record a setup run leaves on each company it filled (trigger "setup", status "done"): the setup run's id.
  /// It makes the company's later runs ordinary ones (not a first picture) — plain id, no relation.
  parentId     String?
  /// "scan" | "catalog" (our catalog got a row this competitor was never checked for) | "manual" (PM-OS admin / CLI)
  /// | "sources" (one of the company's other addresses was removed: what its pages said leaves the picture)
  /// | "setup" (the record of one company's part of a setup run)
  trigger      String
  /// The scan whose end queued it (the newest one when several were folded into one queued run); null for catalog / manual.
  scanId       String?
  startedById  String?
  /// "queued" | "running" | "waiting" (PMOS AI has no capacity; sleeping until resumeAt) | "done" | "failed" | "cancelled"
  status       String     @default("queued")
  /// Display only — where the run is: "map" | "research" | "merge" | "match" | "go_back" | "second_look" | "apply" | "facts" | "done"
  /// (a setup run also: "unify" | "domains").
  /// A resumed run never trusts it: every step recomputes its own to-do from the tables.
  step         String     @default("research")
  /// What cannot be derived: { factsBaselineSources: string[], goBack: { rounds: string[][] } } — the sources whose
  /// first facts read this is, and the pages each go-back round chose (page ids), so a run that stopped reads the same pages.
  /// A setup run keeps one such object per company under { companies: { <competitorId>: {…} } }, and { unify: { reviewed } }.
  cursor       Json       @default("{}")
  /// Set while status = "waiting".
  resumeAt     DateTime?
  /// Times the run was put back in the queue because its runner stopped reporting (3 → failed).
  staleCount   Int        @default(0)
  /// Set by the claim, cleared when the run is put back in the queue or ends: the one worker that executes the run.
  /// Every write of that worker names it, so a worker whose run was swept as stale (its process slept, the database
  /// was away) and claimed again finds zero rows and stops.
  ownerToken   String?
  /// When a runner was last asked to execute the queued run (a Cloud Run job execution, an in-process start). A kick
  /// does not ask again while this is younger than 10 minutes; cleared when the run goes back to the queue.
  launchedAt   DateTime?
  /// TEST KNOB: the run takes injected answers and may never call a model.
  injected     Boolean    @default(false)
  model        String?
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  /// When the apply step last finished (cells are current as of this moment).
  appliedAt    DateTime?
  finishedAt   DateTime?
  heartbeatAt  DateTime   @default(now())
  /// Research progress for the UI.
  pagesTotal   Int        @default(0)
  pagesDone    Int        @default(0)
  /// Everything else that is counted (analysis/engine.ts Counters).
  counters     Json       @default("{}")
  /// The run's tokens split by step and model (analysis/usage.ts): [{ step, model, calls, input, output, cached }].
  /// A setup run's list is the roll-up of its companies' lists (kept in `setup`) and of its shared calls.
  usage        Json       @default("[]")
  /// How the run paced itself (analysis/pacing.ts): { start, max, peak, speed, pushbacks: [{ at, step, company, reason,
  /// speed, next, waitMs, retryAfterMs }], total } — the calls at once it started with, its ceiling, the fastest it got,
  /// and every time the provider pushed back: when, at what speed, how long the run waited. Null = a run from before
  /// pacing was recorded.
  pacing       Json?
  /// The caps this run hit (analysis/caps.ts) — limits are safety nets, so a hit is recorded and surfaced:
  /// [{ cap, limit, competitorId, company, undone, also, times }]. [] = no cap was hit.
  caps         Json       @default("[]")
  /// "none" | "capacity" | "answer" | "ai" | "stale" | "other"
  errorKind    String?
  error        String?
  /// [{at, level, msg, url?}] — same shape as CompetitorScan.log.
  log          Json       @default("[]")

  @@index([status, createdAt])
  @@index([competitorId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([parentId])
}

/// One section of a competitor's READING PLAN (analysis/sections.ts): the stored pages under one address prefix of
/// one source. Code builds the sections; PMOS AI labels each one once (the analysis run's map step), the home page
/// is labeled in code. A saved label is kept like a decision: a later run asks only about sections with no row yet.
model CompetitorSection {
  id           String           @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  sourceId     String
  source       CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Address prefix without the scheme: "acme.com/" (the home page), "acme.com/products", "acme.com/docs/api".
  prefix       String
  /// product | pricing | compare | help | release_notes | api_docs | news | noise
  label        String
  /// Pages and characters of text under the prefix when the plan was last computed (0 = no page there any more).
  pages        Int              @default(0)
  chars        Int              @default(0)
  /// "ai" (the map call) | "code" (the home page)
  labeledBy    String           @default("ai")
  labeledAt    DateTime         @default(now())
  /// MAP_VERSION of the prompt that labeled it; null when code did.
  mapVersion   String?
  /// The run that labeled it (plain id, no relation).
  analysisId   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([competitorId, sourceId, prefix])
  @@index([workspaceId])
}

/// One thing a page says the competitor offers, with the quote that proves it. Written by the research step (one call per
/// page) and by the second look. A finding exists only while its page text is the text it was read from: when the page
/// changes or is removed, its findings are deleted and the page is read again.
model PageFinding {
  id            String          @id @default(uuid())
  workspaceId   String
  competitorId  String
  competitor    Competitor      @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  pageId        String
  page          SourcePage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// SourcePage.hash of the text the quote was verified against.
  pageHash      String
  /// The run that wrote it (plain id, no relation).
  analysisId    String?
  /// "research" | "second_look"
  origin        String          @default("research")
  /// "capability" | "feature"
  kind          String
  /// Their name for it, as the page says it.
  wording       String
  /// For a feature: the wording of the capability it sits under on this page.
  parentWording String?
  /// Verbatim from the page (verified in code), at most 400 characters.
  quote         String
  /// One sentence: why this quote means the capability exists.
  reasoning     String
  /// One plain sentence of what it does, taken only from this page; null when the page does not say.
  description   String?
  /// The competitor's merged item this finding belongs to (set by the merge step; null for second-look findings).
  itemId        String?
  item          CompetitorItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// Second look only: the capability of ours it answers.
  capabilityId  String?
  capability    Capability?     @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@index([pageId])
  @@index([itemId])
  @@index([competitorId, capabilityId])
}

/// One capability or feature of a competitor, in their words, after the same thing on several pages was merged.
/// Carries the saved match to our catalog: decided once, reused on every later run.
model CompetitorItem {
  id              String           @id @default(uuid())
  workspaceId     String
  competitorId    String
  competitor      Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  /// "capability" | "feature"
  kind            String
  /// Stable key: "c:<wordingKey>" or "f:<parent item key>><wordingKey>" (analysis/items.ts itemKey).
  key             String
  /// Their most common wording for it — "the competitor's own name", shown behind the evidence.
  name            String
  /// wordingKeys merged into this item (code merge and saved AI merges): a later finding with one of them joins it without a call.
  wordings        Json             @default("[]")
  parentItemId    String?
  parent          CompetitorItem?  @relation("ItemParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  children        CompetitorItem[] @relation("ItemParent")
  /// False until the item went through one AI merge call.
  mergeChecked    Boolean          @default(false)
  /// The saved match: exactly one of the two is set once the item is settled.
  capabilityId    String?
  capability      Capability?      @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  featureId       String?
  feature         Feature?         @relation(fields: [featureId], references: [id], onDelete: SetNull)
  /// "name" | "alias" (resolved in code through decisions.ts) | "ai" (the match call, or the setup run's unify step)
  /// | "created" (the apply step made the row from this item) | "silent" (it is a row a PM removed or declined:
  /// remembered, never shown) | "excluded" (the setup run's unify step judged it no capability — a commercial term or
  /// a marketing headline: it gets no row, and is never asked again)
  matchedBy       String?
  matchedAt       DateTime?
  matchAnalysisId String?
  /// The match call's answer for an item that is none of ours, kept until the apply step turns it into a row:
  /// { domainId, newDomainName, newDomainDefinition, closestDomainId, marketName, description }.
  /// During a setup run, a capability item's row as the unify step decided it, kept until the domains step creates
  /// the catalog: { setupRow: true, marketName, description } — the row is identified by its name.
  placement       Json?
  /// When a run last went back for this item's gaps to the end (analysis/gaps.ts). The item is gone back for again
  /// only when it got a finding after this moment — so a run with nothing new to read reads nothing for it.
  gapCheckedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  findings PageFinding[]

  @@unique([competitorId, key])
  @@index([competitorId, kind])
  @@index([capabilityId])
  @@index([featureId])
}

/// A detail of how a capability works — the level under a capability in the table. Same PM-decision fields as Capability.
model Feature {
  id           String     @id @default(uuid())
  workspaceId  String
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  /// The org's own mark: "found" | "not_found". A feature found only at competitors starts as not_found.
  ourStatus    String     @default("not_found")
  /// Same rule as Capability: set = a PM's value, never changed by a run.
  ourStatusSetAt   DateTime?
  ourStatusSetById String?
  /// Same shape as Capability.ourEvidence.
  ourEvidence  Json?
  position     Int        @default(0)
  /// "manual" | "ai"
  origin       String     @default("manual")
  /// "active" | "removed" (kept so an analysis never adds it back)
  state        String     @default("active")
  /// Names a PM replaced by renaming.
  aliases      Json       @default("[]")
  removedAt    DateTime?
  removedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  statuses FeatureStatus[]
  items    CompetitorItem[]

  @@unique([capabilityId, name])
  @@index([workspaceId, capabilityId])
}

/// One cell of a feature row. Same rules as CapabilityStatus; no history (the feed does not carry features in this build).
model FeatureStatus {
  id             String     @id @default(uuid())
  workspaceId    String
  competitorId   String
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  featureId      String
  feature        Feature    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  /// "found" | "low" | "not_found"
  value          String     @default("not_found")
  quote          String?
  sourceUrl      String?
  reasoning      String?
  wording        String?
  /// The description of the best-ranked evidence that has one.
  description    String?
  evidenceCount  Int        @default(0)
  analysisId     String?
  changedAt      DateTime?
  overrideValue  String?
  overrideNote   String?
  overrideUserId String?
  overrideAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([competitorId, featureId])
  @@index([workspaceId])
}

/// A lean-profile fact read off the website. `kind` is a closed list:
/// tagline | product | pricingTier | integration | certification | customer | vertical.
model ProfileFact {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  kind         String
  value        String
  sourceUrl    String?
  /// Where it came from, as shown on the card ("LinkedIn", "Trust page", "2024 · press").
  sourceLabel  String?
  /// "warn" paints the source line amber (a change worth noticing).
  tone         String?
  /// The date the source states for the fact (a funding round, a launch, an
  /// acquisition) — the timeline is built from dated facts. Null = undated.
  factDate     DateTime?
  /// PMOS AI's one-line headline and two-sentence digest of the news (what happened, what it is) — the feed and the email show these.
  headline     String?
  summary      String?
  /// The source page's preview image (og:image), fetched when the fact was found.
  imageUrl     String?
  scanId       String?
  /// When the fact appeared or changed — null for facts a source's FIRST scan
  /// found (the baseline is not news; a later scan's new fact is).
  changedAt    DateTime?
  /// A PM's correction; wins over later scans until cleared.
  overrideValue  String?
  overrideUserId String?
  overrideAt     DateTime?
  /// A PM removed this fact; scans never re-add the same value.
  dismissedAt  DateTime?
  /// Typed by a PM (no source page); never stale, never unreachable.
  manual       Boolean    @default(false)
  /// The last scan that found this fact on the site; stale when 3 scans passed without it.
  lastSeenScanId String?
  /// The fact's page vanished or was blocked in a later scan (cleared when seen again).
  unreachableAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([competitorId, kind, value])
  @@index([workspaceId, competitorId])
}

/// Where a competitor's data comes from. Story 2 = one "website" source per
/// competitor; later stories add more types. Schedule inherits the org's
/// competitorsConfig.scanFrequency.
model CompetitorSource {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  /// One of SOURCE_TYPES (lib/competitors/config.ts): website | documents |
  /// helpcenter | video | archive | apidocs | changelog | code | social |
  /// reviews | marketplaces | press | jobs | events | other. The website is
  /// crawled by the scanner, and so is every OTHER ADDRESS of the company —
  /// a helpcenter, apidocs or changelog source whose url is a plain site
  /// address (lib/competitors/addresses.ts): found by PM-OS or added by a PM,
  /// scanned whole on the website's schedule. A company may have several of
  /// one type (docs.acme.com and support.acme.com are both a help center), so
  /// (competitorId, type) is not unique; two sources of one company never
  /// share a site (checked where a source is created). Every other type
  /// receives its pages from a collector (an upload, an import, a later
  /// connector) and runs the same pipeline from there.
  type         String     @default("website")
  url          String
  /// An other address only — how it came to be: "link" (a link on the company's own site) | "llms" (its llms.txt) |
  /// "guess" (a common name in front of its domain, verified) | "manual" (a PM added it). Null for the website, for a
  /// source fed by a collector and for an address added before this was recorded.
  foundVia     String?
  /// The text of the link it was found under, when a link named it.
  foundText    String?
  /// A PM removed the address: it is never scanned, never shown, and never added back by a later search. The row
  /// stays as that memory; its pages are marked removed. Adding the same address by hand brings it back.
  removedAt    DateTime?
  removedById  String?
  /// Scan frequency in days, set per source in Administration (PRD: once every 2 days).
  scanEveryDays Int       @default(2)
  lastScanAt   DateTime?
  /// "never" | "ok" | "partial" | "failed" | "running" | "pending" (waiting for the local lane)
  lastStatus   String     @default("never")
  lastError    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  scans         CompetitorScan[]
  pages         SourcePage[]
  localRequests LocalScanRequest[]
  sections      CompetitorSection[]

  @@index([competitorId, type])
  @@index([workspaceId])
}

/// One scan run of a source, with its log. `log` is an append-only JSON array
/// of {at, level, msg, url?} lines; `pages` summarises each page fetched
/// ({url, status, outcome: new|changed|unchanged|failed|skipped, chars}).
model CompetitorScan {
  id            String           @id @default(uuid())
  workspaceId   String
  sourceId      String
  source        CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// "manual" | "scheduled" | "import" (pages handed to the pipeline by a collector)
  trigger       String
  startedById   String?
  /// The Scan press (or scheduled round) this scan belongs to; null for a single Scan now / import.
  runId         String?
  run           CompetitorScanRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// "queued" (waiting for a slot or for the running scan of the site to end) | "pending_local" (waiting for the local
  /// lane) | "running" | "ok" | "partial" | "failed" | "stale" (no heartbeat for 10 min; the next run resumes it) | "cancelled"
  status        String           @default("queued")
  /// Which lane read the pages: "remote" (the scanner job) | "local" (a PM's browser via the hand-in route) | "bundle" (a collector).
  /// Admin log only — customers never see it.
  lane          String           @default("remote")
  /// The stale scan this one continued (pending pages first).
  resumedFromId String?
  /// Pages discovered but never attempted because the scan stopped early (ceiling, slow down, stale).
  pagesNotAttempted Int          @default(0)
  /// Local lane: page keys the handed-in pages linked to (deduped) — applied to the page store when the scan is processed,
  /// so "unlinked" is decided after every page row exists.
  linkedUrls    Json             @default("[]")
  /// "plain" | "browser" (browser after a bot wall) | "bundle" (pages were handed in, nothing fetched).
  fetchMode     String?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  heartbeatAt   DateTime         @default(now())
  pagesFetched  Int              @default(0)
  pagesChanged  Int              @default(0)
  statusesChanged Int            @default(0)
  factsChanged  Int              @default(0)
  suggestions   Int              @default(0)
  aiCalls       Int              @default(0)
  /// "none" | "timeout" | "http4xx" | "http5xx" | "botwall" | "ai" | "limit" | "other"
  errorKind     String?
  error         String?
  /// What the user sees: "full" | "incomplete" | "blocked" | "unreachable" | "stale" (null while running).
  badge         String?
  /// Not-read page counts by category: {robots, denied, login, notfound, timeout, cap, slowdown}.
  outcomes      Json             @default("{}")
  /// robots.txt paths that kept pages out of this scan (first 50).
  robotsDisallowed Json          @default("[]")
  /// URLs present in the previous scan and gone in this one.
  removedPages  Json             @default("[]")
  /// Snippets or facts dropped by the PII check (expected 0).
  piiHits       Int              @default(0)
  pages         Json             @default("[]")
  log           Json             @default("[]")

  pageTexts    ScanPage[]
  localRequest LocalScanRequest?
  tokens       ScanToken[]

  @@index([workspaceId, startedAt])
  @@index([sourceId, startedAt])
  @@index([runId])
}

/// A news-feed item a user has read (per user; items are derived from statuses,
/// facts and suggestions, so `key` = kind:rowId:timestamp). "Mark all read" inserts
/// one row per item shown.
model CompetitorFeedRead {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  key         String
  readAt      DateTime @default(now())

  @@unique([workspaceId, userId, key])
  @@index([workspaceId, userId])
}

/// One press of Scan on the Competitors page (or one scheduled round): the
/// competitors scanned one after another, and the one notification email sent
/// when the last of them finishes. `summary` is what that email said.
model CompetitorScanRun {
  id          String    @id @default(uuid())
  workspaceId String
  /// "manual" | "scheduled"
  trigger     String
  startedById String?
  /// "running" | "ok" | "failed"
  status      String    @default("running")
  total       Int       @default(0)
  done        Int       @default(0)
  /// The competitor being scanned right now (header progress).
  current     String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  /// {competitors, gaps, raised, lowered, facts, suggestions, recipients, skipped?}
  summary     Json      @default("{}")
  notifiedAt  DateTime?
  /// The claim that makes the run's notification happen once, after the analyses its scans queued.
  summarizedAt DateTime?

  scans CompetitorScan[]

  @@index([workspaceId, startedAt])
}

/// Text of a fetched page, kept for the last 2 scans of a source (older rows
/// keep only the hash); the diff compares hashes, PMOS AI reads the text.
model ScanPage {
  id          String         @id @default(uuid())
  scanId      String
  scan        CompetitorScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  sourceId    String
  url         String
  /// What the text is: page | document | article | transcript | capture | quotes
  /// (quotes = the evidence lines a collector kept when it did not keep the page text).
  kind        String         @default("page")
  title       String?
  contentHash String
  text        String?
  chars       Int            @default(0)
  /// When the content was published or captured, when the source says so
  /// (an article's updated_at, a video's publish date, an archive capture's
  /// timestamp). Null = only the fetch time is known.
  observedAt  DateTime?
  /// Validators for the next scan's conditional request (If-None-Match / If-Modified-Since).
  etag        String?
  lastModified String?
  fetchedAt   DateTime       @default(now())

  @@index([sourceId, url])
  @@index([scanId])
}

/// A UI capture, image or clip of the competitor's product, stored in the
/// media store (lib/competitors/media.ts) under `mediaPath`.
/// The current state of one page of a source (Website Scanning PRD 2026-11-04).
/// One row per URL, kept while the competitor is tracked: hash, title, state and the
/// current text. No retention: a change replaces the text (see previousText).
model SourcePage {
  id          String           @id @default(uuid())
  workspaceId String
  sourceId    String
  source      CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// Canonical page key (lib/competitors/url.ts pageKey).
  url         String
  title       String?
  /// page | document | article | transcript | capture | quotes
  kind        String           @default("page")
  /// sha256 (32 hex) of the normalized text — "changed or not".
  hash        String
  /// The current text, as complete as we could get it; null before the first successful read, and on pages removed by a website change (hash kept).
  text        String?
  chars       Int              @default(0)
  /// "present" | "missing" (not found once) | "removed" (not found twice in a row) | "unlinked" (answers, but no inbound link)
  state       String           @default("present")
  /// Consecutive scans that answered not-found (404/410 or a not-found page in the local lane).
  notFoundStreak Int           @default(0)
  /// "home" | "sitemap" | "link" | "handin" | "discovery" (the site's /llms.txt, stored by the address search — never crawled)
  discoveredVia String         @default("link")
  firstSeenAt DateTime         @default(now())
  /// Last scan that read the page successfully.
  lastReadAt  DateTime?
  lastReadScanId String?
  /// Last scan that attempted the page (read or not).
  lastAttemptScanId String?
  /// Last scan in which an inbound link or sitemap entry pointed at the page.
  lastLinkedScanId String?
  removedAt   DateTime?
  /// When the text last changed (hash moved).
  changedAt   DateTime?
  /// No retention (Daniel 2026-11-04): the text before the last change is held only until the analysis of that change has run,
  /// then dropped. Set on the first change since the last successful analysis, kept across further changes until then.
  previousText String?
  previousHash String?
  /// "<RESEARCH_VERSION>:<hash>" of the text the analysis's research step last read; a different value = the page is due.
  analyzedKey String?
  analyzedAt  DateTime?
  /// Set when the page's research answer was unusable; cleared when the page is read again.
  analysisError String?
  /// "<FACTS_VERSION>:<hash>" of the text the facts step last read.
  factsKey    String?
  updatedAt   DateTime         @updatedAt

  findings PageFinding[]

  @@unique([sourceId, url])
  @@index([workspaceId])
  @@index([sourceId, state])
}

/// A scan waiting for, or running in, the local lane (a PM's browser on a
/// machine that polls PM-OS with a machine key).
model LocalScanRequest {
  id          String           @id @default(uuid())
  workspaceId String
  scanId      String           @unique
  scan        CompetitorScan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  sourceId    String
  source      CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// "waiting" | "running" | "handed_in" (every page is in, PM-OS processes) | "done" | "failed" | "cancelled"
  state       String           @default("waiting")
  /// Times the stale sweep relaunched processing after the hand-in (MAX_PROCESS_ATTEMPTS, then "failed").
  processAttempts Int          @default(0)
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  /// The 24-hour alert email was sent (once per request).
  alertedAt   DateTime?
  /// The machine key that took the request.
  keyId       String?

  @@index([state, createdAt])
  @@index([workspaceId])
}

/// A local station's machine key (server-to-server, no expiry). Created once
/// in Administration; the poller rotates it every 30 days through the check-in
/// call; revoking it here is the only manual act. Serves every workspace.
model ScannerKey {
  id                 String    @id @default(uuid())
  label              String
  keyHash            String    @unique
  /// After a rotation the previous key stays valid for a short grace window.
  previousKeyHash    String?
  previousValidUntil DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
  rotatedAt          DateTime?
  revokedAt          DateTime?
}

/// A short-lived token that can only post pages into one scan. Valid while the
/// scan is pending or running and for 15 minutes after it reached a final state.
model ScanToken {
  id        String         @id @default(uuid())
  scanId    String
  scan      CompetitorScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  tokenHash String         @unique
  createdAt DateTime       @default(now())

  @@index([scanId])
}

/// Global settings set in Administration (one row per key): competitors.remoteScanEnabled,
/// and — in test environments only — the clock knob.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model CompetitorMedia {
  id           String     @id @default(uuid())
  workspaceId  String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  label        String
  kind         String?
  mediaPath    String
  sourceLabel  String?
  capturedAt   DateTime?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([competitorId])
}
