generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// Per-organization feature overrides, e.g. {"ideas": true}. A key that is
  /// present wins; a missing key falls back to the env default (IDEAS_ENABLED
  /// etc.). Managed in PM-OS Admin → Configurations.
  features  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  workspace Workspace?
}

/// Minimized IAM. PMOS_ADMIN grants access to PM-OS Admin. CUSTOMER_ADMIN is a
/// plain user who may also change their own organization's settings (product
/// lines) — never /admin. Default USER = deny-by-default.
enum UserRole {
  USER
  CUSTOMER_ADMIN
  PMOS_ADMIN
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String?
  name                String
  role                UserRole      @default(USER)
  /// Soft-deactivation: set = user cannot log in and active sessions are
  /// rejected. Cleared to reactivate. No hard delete from Admin.
  deactivatedAt       DateTime?
  /// AES-256-GCM encrypted TOTP secret; null until 2FA enrollment starts.
  totpSecretEnc       String?
  /// Set when the user confirms their first TOTP code; null = 2FA off.
  totpEnabledAt       DateTime?
  /// Highest TOTP time-step already consumed — codes are strictly single-use.
  /// Recovery is admin-side (clear the totp fields), not backup codes.
  totpLastUsedStep    Int?
  /// Optional per-user default Product Line filter for the Ideas screen —
  /// names from the workspace catalog. Empty = no default filter.
  defaultProductLines Json          @default("[]")
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions            Session[]
  accounts            OAuthAccount[]
  chatSessions        ChatSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String   @unique
  expiresAt         DateTime
  /// False until the TOTP challenge passes; only checked when the user has
  /// 2FA enabled, so pre-2FA sessions stay valid.
  twoFactorVerified Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @default("My Workspace")
  /// Ideas → Jira output mapping (field names, write policies, description
  /// format, ticket-link template). Customer-facing output rules change
  /// often, so they live in Admin → Ideas, not in code. Shape:
  /// lib/ideas/jira-mapping.ts.
  ideasConfig    Json         @default("{}")
  /// Jira is enabled for the organization, so it must work: when the health
  /// check last found it not working (no connection, project not set, or a
  /// dead token) and emailed PM-OS support (src/lib/jira-alerts.ts). Null =
  /// healthy / not yet alerted; cleared when a check passes again.
  jiraAlertedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  jiraConnection        JiraConnection?
  googleDriveConnection GoogleDriveConnection?
  releases              Release[]
  documents             Document[]
  chatSessions          ChatSession[]
  qaLogs                QALog[]
  zendeskTickets        ZendeskTicketRaw[]
  ledgerEntries         LedgerEntry[]
  ideaBatches           IdeaBatch[]
  ideas                 Idea[]
  jiraIdeaSnapshots     JiraIdeaSnapshot[]
  reviewEvents          ReviewEvent[]
  productLines          ProductLine[]
  usageEvents           UsageEvent[]
  platforms             Platform[]
  customers             Customer[]
  ideasPushUndos        IdeasPushUndo[]
}

/// Per-idea undo snapshot for the LAST merge to Jira only — executePush
/// clears the workspace's rows before writing new ones, and a successful
/// undo deletes its row. Payload shape: src/lib/ideas/undo.ts.
model IdeasPushUndo {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideaId      String    @unique
  jiraKey     String
  action      String // "create" | "update"
  payload     Json
  commentId   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

/// Workspace-scoped product-line catalog, managed in Settings → Ideas.
/// Idea.products stays plain strings; this is the reference list.
model ProductLine {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Manual sort order (Settings → Ideas → Product Lines); ties break by name.
  position    Int       @default(0)
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  /// "manual" (Settings → Ideas) or "jira" (auto-created by the Jira pull
  /// from the configured product-line field — see IdeasJiraConfig.pull).
  origin      String    @default("manual")
  /// Other spellings that mean this product line — the customer's Jira option
  /// name ("Platform General" for "Platform"), reporters' variants. Matched by
  /// normalized key on import (Jira pull and Zendesk Module); on push the
  /// alias that is a Jira option is written.
  aliases     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Workspace-scoped customer catalog, managed in Settings → Ideas. The
/// catalog stage tags tickets with affected customers from this list only —
/// a closed vocabulary, so idea views never show invented customer names.
model Customer {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Chip color — a palette id from lib/ideas/colors.ts, never a hex.
  color       String?
  /// Spellings merged into this customer (Settings → Customers → Merge);
  /// imports map them here, and a merge can be split back out.
  aliases     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Workspace-scoped platform catalog (iOS, Web, …), managed in Settings → Ideas.
model Platform {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model JiraConnection {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cloudId         String
  siteUrl         String
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  /// "basic" — the only supported style since 2026-10-20: a dedicated PM-OS
  /// user + Atlassian API token per organization, set by the PM-OS admin.
  /// accessToken holds base64(email:token) sealed at rest, refreshToken is
  /// empty, expiresAt is far future, requests go to siteUrl directly.
  /// "oauth" rows are legacy (the customer self-connect path was removed)
  /// and count as unavailable until the PM-OS user is set.
  authType        String    @default("basic")
  /// The Jira account behind the token (GET /myself at save time) — shown
  /// in Settings as "Connected as <name> user".
  connectedByName  String?
  connectedByEmail String?
  /// When the API token expires (admin-set at creation, max 1 year). Null = unknown.
  apiTokenExpiresAt DateTime?
  /// When the "token expires soon" email went out to PM-OS support
  /// (src/lib/jira-alerts.ts); cleared when a new token is saved. The
  /// outage flag lives on Workspace.jiraAlertedAt (a missing row must alert too).
  expiryWarnedAt  DateTime?
  projectKeys     String    @default("[]")
  prdSource       String    @default("epic_description")
  /// Ideas write-back target: new ideas become issues of this type in this
  /// project. Must be one of projectKeys so the next import sees what we
  /// created. Null + a single selected project = that project.
  ideasProjectKey String?
  ideasIssueType  String    @default("Story")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GoogleDriveConnection {
  id           String    @id @default(uuid())
  workspaceId  String    @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String?
  folderIds    String    @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Release {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  jiraProjectKey  String
  jiraVersionId   String?
  jiraVersionName String?
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  documents Document[]

  @@index([workspaceId])
}

model Document {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  releaseId    String?
  release      Release?  @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  type         String
  title        String
  body         String    @default("")
  audience     String    @default("external")
  status       String    @default("draft")
  jiraKeys     String    @default("[]")
  driveFileIds String    @default("[]")
  version      Int       @default(1)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
  @@index([releaseId])
}

model ChatSession {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String    @default("New chat")
  context     String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages ChatMessage[]

  @@index([workspaceId])
  @@index([workspaceId, userId])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  String      @default("{}")
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model QALog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueKey    String?
  question    String
  answer      String
  citations   String    @default("[]")
  confidence  String    @default("medium")
  helpful     Boolean?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

// ————— Ideas pipeline (Kela POC) —————

/// Raw Zendesk store — tickets exactly as received (PRD). The scrub gate
/// operates on `raw` before anything leaves this store.
model ZendeskTicketRaw {
  id                  String     @id @default(uuid())
  workspaceId         String
  workspace           Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId          String
  subject             String
  body                String
  requester           String?
  /// Customers the catalog stage matched in the ticket text (from the
  /// Customer catalog). Idea-level lists are derived from sources, so this
  /// per-ticket verdict is the single source of truth. Never edited by
  /// review actions — dismissals live in dismissedCustomers so they are
  /// always reversible.
  affectedCustomers   Json       @default("[]")
  /// Names a PM dismissed from the idea view; subtracted from the derived
  /// idea list at read time and restorable at any time.
  dismissedCustomers  Json       @default("[]")
  tags                Json       @default("[]")
  productLine         String?
  /// Reporter-chosen module/product hint (e.g. Zendesk "Module" field) —
  /// a metadata hint for classification, never an override.
  module              String?
  /// Customer named by the reporter in a dedicated field — treated as truth.
  customerName        String?
  /// The reporter marked the ticket as affecting all customers (parsed from
  /// values like "All customers" in the customer fields).
  affectsAllCustomers Boolean    @default(false)
  /// Reporter's "why should we build this" text — interpretation, same
  /// grain of salt as the rest of the ticket.
  whyBuild            String?
  /// Reporter's "what insights do we have" text — interpretation.
  insights            String?
  /// e.g. Yes / No / Helpful — deal linkage as reported.
  dealRelated         String?
  /// e.g. Customer / POC.
  customerType        String?
  /// Direct link to the source ticket; preferred over the URL template.
  url                 String?
  sourceCreatedAt     String?
  /// What the match stage decided per FR unit of this ticket:
  /// [{ unit, ideaId, merged, reason }] — the PM-facing "why" next to the idea link.
  matchNotes          Json       @default("[]")
  raw                 Json
  batchId             String?
  batch               IdeaBatch? @relation(fields: [batchId], references: [id])
  importedAt          DateTime   @default(now())
  catalogKind         String?
  catalogReason       String?

  sources IdeaSource[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
}

/// Verdict ledger — every LLM judgment ever made, content-keyed. Replay of
/// these rows (not model behavior) is what makes the pipeline deterministic.
model LedgerEntry {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String
  stage         String
  promptVersion String
  model         String
  input         Json
  verdict       Json
  createdAt     DateTime  @default(now())

  // Append-only: the same key may appear once per run — comparing rows that
  // share a key is how determinism gets measured, so no unique constraint.
  @@index([workspaceId, key])
  @@index([workspaceId, stage])
}

/// One import run — audit trail plus the notify step later.
model IdeaBatch {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  stats       Json?
  /**
   * running | completed | failed | aborted (server stopped mid-import).
   */
  status      String    @default("running")
  error       String?
  /**
   * Touched after every model call and stage; a stale beat on a running batch = dead run.
   */
  heartbeatAt DateTime  @default(now())
  /**
   * Per-stage timings, call counts, token usage — see src/lib/ideas/trace.ts.
   */
  trace       Json?

  tickets ZendeskTicketRaw[]

  @@index([workspaceId])
}

model Idea {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  details        String
  products       Json      @default("[]")
  platforms      Json      @default("[]")
  batchStatus    String
  decision       String
  origin         String
  /// Human-readable narration of what this import did to an Updated idea
  /// (votes, enrichment, added product lines/platforms). Cleared on rollover.
  batchChanges   Json      @default("[]")
  /// Customers a PM added by hand (names). Ticket-derived customers are
  /// never stored here; removing one of those is a dismissal on its tickets.
  addedCustomers Json      @default("[]")
  /// A PM changed the sources after PMOS AI wrote the text: approval is
  /// blocked until the idea is rewritten from its current sources or the PM
  /// explicitly keeps the text (Daniel, 2026-10-19).
  sourcesChanged Boolean   @default(false)
  pmScore        Int?
  manualScore    Int?
  existingVotes  Int       @default(0)
  newVotes       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sources IdeaSource[]
  events  ReviewEvent[]

  @@index([workspaceId])
}

/// Idea ⇄ source links. Zendesk sources are FKs into the raw store; Jira
/// sources are plain issue keys because Jira is live-state, not ours.
model IdeaSource {
  id       String            @id @default(uuid())
  ideaId   String
  idea     Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind     String
  ticketId String?
  ticket   ZendeskTicketRaw? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  jiraKey  String?

  @@index([ideaId])
  @@index([ticketId])
}

/// Jira live-state snapshot, replaced wholesale on every import — a render
/// cache, not a system of record.
model JiraIdeaSnapshot {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key             String
  title           String
  body            String
  status          String?
  url             String?
  components      Json      @default("[]")
  /// Shown on the raw Jira issue in the drawer, like the Zendesk ticket's fields.
  issueType       String?
  priority        String?
  reporter        String?
  assignee        String?
  sourceCreatedAt DateTime?
  syncedAt        DateTime  @default(now())
  /// Customers read from the issue's summary + description (customer-mentions.ts):
  /// catalog names from the deterministic pass, as-written names from the AI
  /// pass (suggestions until approved). PM-OS data, not Jira's — the sync
  /// upserts rows so these survive every pull.
  affectedCustomers  Json    @default("[]")
  /// Names the PM dismissed on this issue (reversible, like a ticket's).
  dismissedCustomers Json    @default("[]")
  /// Hash of the text the AI pass last read; unchanged text = no new call.
  customersTextHash  String?

  @@unique([workspaceId, key])
}

/// Append-only training signal: every manual decision and edit (PRD, day one).
model ReviewEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideaId      String
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  action      String
  payload     Json?
  /// Who did it (null for events logged before 2026-10-19 or by jobs).
  userId      String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, ideaId])
  @@index([workspaceId, createdAt])
}

/// Product-usage telemetry (Admin → Analytics): one narrow append-only row
/// per client event — page views, drawer opens, filters, searches, imports.
/// Behaviour only; decisions and edits are ReviewEvents. Same Postgres for
/// now (one customer, a few thousand rows a day at most); the client batches
/// writes, rows older than the retention window are purged on admin read.
model UsageEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  /// Client tab id for the browsing session (not the auth session).
  sessionId   String?
  event       String
  path        String?
  props       Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, event, createdAt])
}

/// Single-use password-reset tokens (forgot-password email links). Only the
/// SHA-256 hash of the token is stored; the raw token exists only in the
/// emailed link. 24h expiry; consumed on use; password-type users only.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
