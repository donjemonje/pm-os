<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- PM-OS local scan station: the menu bar indicator (one for every installed environment). install-menu.sh
       compiles menubar.swift, fills in the paths and loads this. It starts at login and is restarted if it crashes;
       "Hide this icon" in its menu ends it until the next login. -->
  <key>Label</key><string>com.pm-os.local-scan.menu</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>--root</string>
    <string>__ROOT__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
